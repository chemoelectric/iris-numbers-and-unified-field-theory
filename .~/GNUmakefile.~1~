.PHONY: default
.PHONY: quick-install install upload
.PHONY: clean
.PHONY: tidy

clean::
	-rm -f tmp.* *.tmp

clean::
	-rm -f PHYSICS.html

default::
	@echo There is no meaningful ‘default’ goal.

quick-install:: $(QUICK_INSTALLED_FILES) tidy
	$(call upload-www,$(QUICK_INSTALLED_FILES))

install upload:: $(INSTALLED_FILES) tidy
	$(call upload-www,$(INSTALLED_FILES))

tidy:: index.html
	for f in $(^); do \
	  $(call tidy-up, "$${f}") > "tmp.$${f}" \
	    && mv "tmp.$${f}" "$${f}"; \
	done
